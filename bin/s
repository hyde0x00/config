#!/usr/bin/env bash

while getopts ":p" opt; do
  case "$opt" in
    p) print_result=true ;;
    ?) forward_args+=("-$OPTARG") ;;
  esac
done

shift $((OPTIND-1))

forward_args+=("$@")

result="$(g "${forward_args[@]}" | __select_with fzf --delimiter=':' --nth='3..')"
status="$?"

if [ "$status" -ne 0 ]; then
  exit "$status"
fi

while [[ "$result" =~ (.+):([0-9]+): ]]; do
  file="${BASH_REMATCH[1]}"
  lnum="${BASH_REMATCH[2]}"
  if [ -f "$file" ]; then
    break
  else
    result="${BASH_REMATCH[1]}"
  fi
done

if [ "$print_result" == true ]; then
  printf '%s\n%s\n%d\n' "$result" "$file" "$lnum"
else
  ${EDITOR:-vi} +"$lnum" -- "$file"
fi
