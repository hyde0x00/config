#!/bin/bash

if [ "$#" -ne 2 ]; then
  echo "Usage: $(basename "$0") [album.cue] [album.flac]"
  exit 1
fi

cue_file="$1"
flac_file="$2"

shnsplit -f "$cue_file" -t "%n. %t" -o flac "$flac_file"

exit 

